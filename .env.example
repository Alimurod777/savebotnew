# Copy to .env and fill with your own values. Never commit the real .env.
# Telegram application credentials (my.telegram.org)
API_ID=0
API_HASH=
# BotFather token
BOT_TOKEN=
# Your numeric Telegram account ID
OWNER_ID=0
OWNER_USERNAME=
# MongoDB backup URI. Empty uses local SQLite for supported local-first paths.
DB_URI=
# Optional bot MTProto session; leave empty unless configured deliberately.
BOT_SESSION=
FORCE_SUB_ENABLED=false
TEMP_DOWNLOAD_DIR=downloads/temp
# Optional conversation log channel/supergroup ID. Bot must be an admin.
# Owner can configure this live with /logchannel set <ID>.
# Saved owner settings override ENV; /logchannel reset returns to ENV.
LOG_CHANNEL_ID=0
